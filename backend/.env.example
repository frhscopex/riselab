# Application
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Frontend URL used by backend redirects (Stripe success/cancel)
FRONTEND_URL=http://localhost:3000

# Database
# For local development, point both URLs at the same Postgres instance if needed.
DATABASE_URL=postgresql://user:password@localhost:5432/riselab?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/riselab?schema=public

# Stripe (Billing)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxx

# Firebase (Authentication)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abcdef

# Optional Supabase health check route (/api/awareness/supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
